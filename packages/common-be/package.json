{
  "name": "@urapps/common-be",
  "version": "1.0.0-rc.0",
  "description": "ur apps backend common library",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "nest build",
    "build:dev": "nest build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "files": [
    "lib",
    "eslint.config.mjs",
    "prettier.config.mjs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./eslint": "./eslint.config.mjs",
    "./prettier": "./prettier.config.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "ISC",
  "author": "Garry Freeman <garryfreeman09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ur-apps/common.git"
  },
  "homepage": "https://github.com/ur-apps/common#readme",
  "bugs": {
    "url": "https://github.com/ur-apps/common/issues"
  },
  "peerDependencies": {
    "@eslint/js": "10.x",
    "@ianvs/prettier-plugin-sort-imports": "4.x",
    "@nestjs/common": "12.x",
    "@nestjs/core": "12.x",
    "@nestjs/microservices": "12.x",
    "@nestjs/swagger": "12.x",
    "@urapps/common": "^1.0.0-rc.0",
    "class-transformer": "0.x",
    "class-validator": "0.x",
    "eslint": "10.x",
    "globals": "17.x",
    "reflect-metadata": "0.x",
    "rxjs": "7.x",
    "typescript-eslint": "8.x"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "@ianvs/prettier-plugin-sort-imports": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/cli": "12.x",
    "@nestjs/schematics": "12.x",
    "@nestjs/testing": "12.x",
    "@types/express": "5.x",
    "@urapps/tsconfig": "^1.0.0-rc.0"
  }
}
