{
  /* Visit https://aka.ms/tsconfig to read more about this file */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Modules
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "constants/": ["./src/constants/index.ts"],
      "decorators": ["./src/decorators/index.ts"],
      "dtos": ["./src/dtos/index.ts"],
      "exceptions": ["./src/exceptions/index.ts"],
      "helpers": ["./src/helpers/index.ts"],
      "interfaces": ["./src/interfaces/index.ts"]
    },

    // Emit
    "noEmit": false,
    "outDir": "./lib",
    "declaration": true,

    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.common-be.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "dist", "lib", "**/*.test.ts", "**/*.spec.ts", "**/*.test.data.ts"]
}
