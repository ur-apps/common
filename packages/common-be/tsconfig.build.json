{
  /* Visit https://aka.ms/tsconfig to read more about this file */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Modules
    "rootDir": "./src",
    "paths": {
      "constants/": ["./src/constants"],
      "decorators": ["./src/decorators"],
      "dto": ["./src/dto"],
      "exceptions": ["./src/exceptions"],
      "helpers": ["./src/helpers"],
      "interfaces": ["./src/interfaces"]
    },

    // Emit
    "noEmit": false,
    "outDir": "./lib",
    "declaration": true,
    "sourceMap": true,

    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.common-be.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "dist", "lib", "**/*.test.ts", "**/*.spec.ts"]
}
