{
  /* Visit https://aka.ms/tsconfig to read more about this file */
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    // Modules
    "rootDir": ".",
    "types": ["node", "jest"],

    // Emit
    "noEmit": true,

    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.common-be.test.tsbuildinfo"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts", "tests/**/*.spec.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", "build", "dist", "lib"]
}
