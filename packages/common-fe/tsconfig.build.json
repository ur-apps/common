{
  /* Visit https://aka.ms/tsconfig to read more about this file */
  "extends": "@urapps/tsconfig/react",
  "compilerOptions": {
    // Modules
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true,

    // Emit
    "outDir": "./lib",
    "declaration": true,

    // Projects
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.common-fe.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "dist", "lib", "**/*.test.ts", "**/*.test.tsx"]
}
