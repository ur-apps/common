{
  "name": "@urapps/common",
  "version": "1.0.0-rc.1",
  "description": "UR Apps platform-agnostic utilities",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:pack": "npm run build && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "ISC",
  "author": "Garry Freeman <garryfreeman09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ur-apps/common.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/ur-apps/common/tree/master/packages/common#readme",
  "bugs": {
    "url": "https://github.com/ur-apps/common/issues"
  },
  "devDependencies": {
    "@urapps/eslint-config": "^1.0.0-rc.1",
    "@urapps/prettier-config": "^1.0.0-rc.1",
    "@urapps/tsconfig": "^1.0.0-rc.1"
  }
}
