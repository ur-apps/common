{
  "name": "@urapps/eslint-config",
  "version": "1.0.0-rc.2",
  "description": "UR Apps shared ESLint configs",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "files": [
    "base.mjs",
    "nest.mjs",
    "react.mjs"
  ],
  "exports": {
    ".": "./base.mjs",
    "./base": "./base.mjs",
    "./nest": "./nest.mjs",
    "./react": "./react.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "ISC",
  "author": "Garry Freeman <garryfreeman09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ur-apps/common.git",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/ur-apps/common/tree/master/packages/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/ur-apps/common/issues"
  },
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "5.x",
    "@eslint/js": "10.x",
    "eslint": "10.x",
    "eslint-plugin-react-hooks": "7.x",
    "eslint-plugin-react-refresh": "0.x",
    "globals": "17.x",
    "typescript-eslint": "8.x"
  },
  "peerDependenciesMeta": {
    "@eslint-react/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@urapps/prettier-config": "^1.0.0-rc.2"
  }
}
