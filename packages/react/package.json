{
  "name": "@urapps/react",
  "version": "1.0.0-rc.2",
  "description": "UR Apps React utilities",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "build:pack": "npm run build && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "ISC",
  "author": "Garry Freeman <garryfreeman09@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ur-apps/common.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ur-apps/common/tree/master/packages/react#readme",
  "bugs": {
    "url": "https://github.com/ur-apps/common/issues"
  },
  "peerDependencies": {
    "@types/react": "19.x",
    "@urapps/common": "^1.0.0-rc.0",
    "react": "19.x"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.x",
    "@testing-library/dom": "10.x",
    "@testing-library/react": "16.x",
    "@types/react": "19.x",
    "@types/react-dom": "^19.x",
    "@urapps/eslint-config": "^1.0.0-rc.2",
    "@urapps/prettier-config": "^1.0.0-rc.2",
    "@urapps/tsconfig": "^1.0.0-rc.2",
    "eslint-plugin-react-hooks": "7.x",
    "eslint-plugin-react-refresh": "0.x",
    "jsdom": "30.x",
    "react-dom": "19.x"
  }
}
